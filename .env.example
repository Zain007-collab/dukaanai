# Claude API key (group key, $2 limit). Never commit the real one.
ANTHROPIC_API_KEY=sk-ant-...
# Neon Postgres connection string (use the pooled one). Leave empty for local in-memory dev.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Password for the seller dashboard
ADMIN_TOKEN=change-me
# Local testing only: run the agent on Gemini instead of Claude (production always uses claude-haiku-5-5)
LLM_PROVIDER=claude
GOOGLE_API_KEY=
